# ============================================================
# Topfy Affiliate OS — variáveis de ambiente (copie para .env)
# ============================================================
# NUNCA commite o .env. Preencha apenas o que for usar.

# ---- Supabase (crie o projeto em https://supabase.com) ----
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=cole-a-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-aqui

# Variantes públicas (web) — devem repetir URL e anon key acima
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-anon-key-aqui

# ---- AliExpress Affiliate API (oficial, credenciada) ----
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# ---- Shopee Affiliate Open API Brasil (oficial, credenciada) ----
# Solicite App ID e Secret em https://affiliate.shopee.com.br/open_api.
# Este bloco é da API de afiliados, não da Open Platform de vendedores.
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
SHOPEE_AFFILIATE_ENDPOINT=https://open-api.affiliate.shopee.com.br/graphql
# Até 5 Sub IDs separados por vírgula para rastrear canal/campanha.
SHOPEE_AFFILIATE_SUB_IDS=canaltopfy,telegram

# Comece false; habilite somente após validar autenticação e shortlink oficial.
SHOPEE_DISCOVERY_ENABLED=false
SHOPEE_DISCOVERY_ORG_ID=
SHOPEE_DISCOVERY_TERMOS=smartphone,notebook gamer,monitor gamer 144hz,smart tv 4k,console videogame,console portatil,controle hall effect,teclado mecanico,mouse gamer,headset gamer,placa mae b550,processador ryzen,placa de video rtx 5060,ssd nvme,memoria ram ddr4,fonte 650w,gabinete mini itx,water cooler,kit fans argb,roteador wifi 6,hub usb c,power bank
SHOPEE_DISCOVERY_MIN_DISCOUNT=10
SHOPEE_DISCOVERY_MIN_SCORE=60
SHOPEE_DISCOVERY_MAX_NOVOS=10
SHOPEE_DISCOVERY_INTERVAL_MINUTES=5
SHOPEE_DISCOVERY_TERMS_PER_CYCLE=3
SHOPEE_DISCOVERY_QUEUE_ID=

# Campanhas de cupom/voucher via shopeeOfferV2 oficial. O link retornado ja
# usa as credenciais de afiliado acima. Comece false e habilite apos o teste.
SHOPEE_COUPON_DISCOVERY_ENABLED=false
SHOPEE_COUPON_DISCOVERY_ORG_ID=
SHOPEE_COUPON_DISCOVERY_INTERVAL_MINUTES=15
SHOPEE_COUPON_DISCOVERY_MAX_NEW=3

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Username do bot (mostrado em /integracoes), ex: @meubot
TELEGRAM_BOT_USERNAME=
CANALTOPFY_PUBLIC_BASE_URL=http://localhost:3000
# Grupo/canal padrão das publicações. Descubra com o bot já dentro do
# grupo: python -m publishers.telegram find-chat (apps/worker)
TELEGRAM_CHAT_ID=
# Link de convite/@usuário público do GRUPO de ofertas (não o bot) — é
# pra onde os CTAs "Receber/Acompanhar no Telegram" do site apontam.
# Ex.: https://t.me/+XXXXXXXXXXXXXXXX ou https://t.me/seu_canal_publico
TELEGRAM_GROUP_URL=

# ---- Cards de produto: next/og (ImageResponse), embutido no Next.js ----
# Nenhuma variável de ambiente necessária — sem conta externa, custo zero.
# (Substitui Pictify: serviço pago de terceiro, só 50 imagens grátis/mês,
# descartado pela regra do projeto de priorizar open source/built-in.)

# ---- OpenRouter (agregador de LLMs hospedado, API formato OpenAI) —
# provider principal no MVP. Crie a key grátis em openrouter.ai/keys.
# Confirme o slug de modelo grátis vigente em openrouter.ai/models
# (filtro "free") antes de trocar OPENROUTER_MODEL.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat:free

# ---- WhatsApp Business Cloud API (Fase 2 / mock no MVP) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Amazon Creators API (mock até atingir elegibilidade) ----
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=

# ---- Influenciador Magalu / Magazine Voce ----
# O programa nao fornece token de afiliado. A vitrine e o identificador de
# atribuicao; paginas especiais usam showcase=magazine<slug>.
MAGALU_STORE_SLUG=
MAGALU_STOREFRONT_URL=
MAGALU_COUPONS_URL=

# ---- Mercado Livre (somente importação manual; automação proibida) ----
# ML_REDIRECT_URI precisa ser exatamente igual à "URL de redirecionamento
# de autenticação" cadastrada no app em developers.mercadolivre.com.br.
# O ML exige https e rejeita qualquer endereço contendo "localhost". No dev
# local use domínio de loopback sem essa palavra (ex: https://lvh.me:3000/callback,
# resolve para 127.0.0.1) e suba o Next com `npm run dev:https`. Em produção,
# cadastre a URL https do domínio (ex: Vercel) — o ML aceita vários URIs.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://lvh.me:3000/callback

# Descoberta supervisionada pela API oficial (não faz scraping e não gera
# link afiliado por endpoint privado). A conta precisa estar conectada em
# /integracoes e o worker precisa estar rodando continuamente.
ML_DISCOVERY_ENABLED=false
ML_DISCOVERY_ORG_ID=
ML_DISCOVERY_TERMOS=smartphone,notebook gamer,monitor gamer 144hz,smart tv 4k,console videogame,console portatil,controle hall effect,teclado mecanico,mouse gamer,headset gamer,placa mae b550,processador ryzen,processador xeon,placa de video rtx 5060,ssd nvme,memoria ram ddr4,memoria ram ddr5,fonte 650w,gabinete mini itx,water cooler,kit fans argb,webcam,microfone usb,roteador wifi 6,hub usb c,power bank,carregador rapido,tablet,caixa de som bluetooth
ML_DISCOVERY_MIN_DISCOUNT=10
ML_DISCOVERY_MAX_NOVOS=10
ML_DISCOVERY_INTERVAL_MINUTES=5
# Alterna os termos entre ciclos; evita consultar toda a lista a cada 5 min.
ML_DISCOVERY_TERMS_PER_CYCLE=2
# Tendencias mudam semanalmente: consulte poucas e recarregue no maximo a
# cada 6 horas, mesmo quando o ciclo de preco roda a cada 5 minutos.
ML_DISCOVERY_TRENDS_ENABLED=true
ML_DISCOVERY_TREND_LIMIT=3
ML_DISCOVERY_TREND_REFRESH_MINUTES=360
# /highlights exige IDs de categorias-folha (ex.: MLB432825). Deixe vazio
# ate escolher categorias coerentes com o canal.
ML_DISCOVERY_HIGHLIGHT_CATEGORIES=
ML_DISCOVERY_HIGHLIGHT_LIMIT=5
ML_DISCOVERY_HIGHLIGHT_CATEGORIES_PER_CYCLE=8
ML_DISCOVERY_HIGHLIGHT_REFRESH_MINUTES=60
# Teto de chamadas /sale_price por ciclo para evitar rajadas e HTTP 429.
ML_DISCOVERY_MAX_PRICE_CHECKS=20

# ---- Agente interno de reabastecimento (reserva de ofertas) ----
# Verifica a fila em background. Ao chegar em MIN_ITEMS, repõe aos poucos até
# TARGET_ITEMS, sem bloquear o publicador e sem duplicar campanhas.
REPLENISHER_ENABLED=false
REPLENISHER_ORG_ID=
REPLENISHER_QUEUE_ID=
REPLENISHER_TERMS=smartphone,notebook gamer,monitor gamer 144hz,smart tv 4k,console videogame,console portatil,controle hall effect,teclado mecanico,mouse gamer,headset gamer,fone qcy,placa mae b550,processador ryzen,processador xeon,placa de video rtx 5060,ssd nvme,memoria ram ddr4,memoria ram ddr5,fonte 650w,gabinete mini itx,water cooler,kit fans argb,webcam,microfone usb,roteador wifi 6,hub usb c,power bank,carregador rapido,tablet,caixa de som bluetooth
REPLENISHER_MIN_ITEMS=84
REPLENISHER_TARGET_ITEMS=96
REPLENISHER_MAX_NEW_PER_CYCLE=4
REPLENISHER_MIN_SCORE=35
REPLENISHER_INTERVAL_MINUTES=5
# Mix desejado da fila ativa; os três valores devem somar 100.
REPLENISHER_SHOPEE_TARGET_PERCENT=40
REPLENISHER_ALIEXPRESS_TARGET_PERCENT=10
REPLENISHER_ML_TARGET_PERCENT=30
REPLENISHER_MAGALU_TARGET_PERCENT=20
# Bridge opcional do Hermes/Chrome. Deve devolver somente links produzidos no
# Link Builder oficial com official_tool_confirmed=true.
HERMES_LINK_AGENT_URL=
HERMES_LINK_AGENT_TOKEN=
